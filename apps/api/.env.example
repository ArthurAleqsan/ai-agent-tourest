# ---------------------------------------------------------------------------
# Tourest AI Lead Hunter - API environment
# Copy this file to `.env` and adjust as needed. DO NOT put secrets here.
# All defaults are local-first and cost $0.
# ---------------------------------------------------------------------------

# HTTP server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the web app dev server)
WEB_ORIGIN=http://localhost:5173

# SQLite database file (relative to apps/api). Created automatically.
DATABASE_PATH=./data/tourest.db

# Local Ollama HTTP API (no API key, runs on your machine).
# Install Ollama, then: `ollama pull qwen3:4b` (any locally available Qwen3 tag).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# AI reliability controls
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_RETRIES=2
OLLAMA_TEMPERATURE=0

# --- Source adapters (Step 3) ---
# Telegram Bot API. Create a bot via @BotFather, add it to AUTHORIZED groups
# only, and keep privacy mode ON. The token is a secret: set it in .env (never
# commit it). Leave empty to disable Telegram ingestion.
TELEGRAM_BOT_TOKEN=
# Optional shared secret checked on POST /api/telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=
# Cron schedule for the Telegram polling job (every 2 minutes by default).
INGESTION_TELEGRAM_CRON=*/2 * * * *

# --- Tour catalog (Step 4) ---
# Optional AUTHORIZED Tourest catalog endpoint. We do NOT assume or invent any
# Tourest API: leave this empty and import a CSV/JSON export instead, OR set it
# to an endpoint you are explicitly authorized to use. The token value is sent
# verbatim in TOUR_CATALOG_API_HEADER (supply your own scheme, e.g. "Bearer ...").
TOUR_CATALOG_API_URL=
TOUR_CATALOG_API_TOKEN=
TOUR_CATALOG_API_HEADER=Authorization

# --- Admin authentication (Step 5) ---
# Local dashboard credentials. Leave ADMIN_PASSWORD empty to disable auth
# (local development only — a warning is logged). Set a strong password in
# `.env` (never commit it) before exposing the dashboard on a network.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Comma-separated job names that should start disabled
# (e.g. "ai-qualification,draft-generation").
JOBS_DISABLED=

# Logging
LOG_LEVEL=info
