# ---------------------------------------------------------------------------
# Tourest AI Lead Hunter - API environment
# Copy this file to `.env` and adjust as needed. DO NOT put secrets here.
# All defaults are local-first and cost $0.
# ---------------------------------------------------------------------------

# HTTP server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the web app dev server)
WEB_ORIGIN=http://localhost:5173

# SQLite database file (relative to apps/api). Created automatically.
DATABASE_PATH=./data/tourest.db

# Local Ollama HTTP API (used in a later step; no API key, runs on your machine)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Logging
LOG_LEVEL=info
