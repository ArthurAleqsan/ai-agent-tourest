# ---------------------------------------------------------------------------
# Tourest AI Lead Hunter - Web environment
# Copy to `.env`. No secrets. Only VITE_-prefixed vars reach the browser.
# ---------------------------------------------------------------------------

# Base URL for API requests. Leave empty to use the Vite dev proxy (/api).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api during development.
VITE_API_PROXY_TARGET=http://localhost:4000
